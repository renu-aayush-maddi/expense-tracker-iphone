# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# development | production
ENVIRONMENT=development

# PostgreSQL connection string.
# Local:    postgresql://YOUR_USER@localhost:5432/expense_tracker
# Supabase: Project -> Connect -> "Session pooler" URI, then add ?sslmode=require
#           postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# Long random string (64+ chars). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma separated list of frontend URLs allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Set to false after you've created your own account
ALLOW_REGISTRATION=true

# Timezone used for "today" / "this month"
APP_TIMEZONE=Asia/Kolkata

# Swagger UI at /docs
ENABLE_DOCS=true

# Optional: AI fallback for receipts the parser can't fully read (e.g. ₹ read as ¥).
# Create a key at https://platform.openai.com/api-keys. Leave empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT_SECONDS=20

# Limits
MAX_REQUEST_BYTES=65536
IMPORT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
